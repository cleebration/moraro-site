{
  // Cloudflare Worker mit statischen Assets — Aufbau wie klangerie-site / babowalls.com.
  "name": "moraro-site",
  "compatibility_date": "2026-10-15",
  "main": "worker/index.js",

  // workers.dev-Adresse: Vorschau, solange moraro.world noch nicht auf Cloudflare zeigt.
  "workers_dev": true,
  "preview_urls": true,

  // Die eigenen Namen. Cloudflare legt die DNS-Einträge beim Deploy selbst an.
  // Der Worker führt www.moraro.world auf moraro.world.
  // Zone moraro.world in Cloudflare seit 15.10.2026 (Nameserver frank/keira.ns.cloudflare.com),
  // GoDaddy-Parkseite (A @ ×2, CNAME www) entfernt. Erst deployen, wenn die Zone „Active“ ist.
  "routes": [
    { "pattern": "moraro.world",     "custom_domain": true },
    { "pattern": "www.moraro.world", "custom_domain": true }
  ],

  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },

  "observability": { "enabled": true }
}
